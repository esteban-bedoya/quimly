# Debe ser HTTPS y accesible públicamente para que Mercado Pago entregue webhooks.
NEXT_PUBLIC_APP_URL=https://tu-dominio-publico.example

# Mercado Pago: la primera integración usa cuentas y tarjetas de prueba.
MERCADO_PAGO_ENVIRONMENT=sandbox
MERCADO_PAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_SANDBOX_PAYER_EMAIL=
MERCADO_PAGO_WEBHOOK_SECRET=

# Requeridas por el backend y por el verificador Sandbox. Nunca exponer la service role al navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
